# Rakshabandhan Backend Environment Variables
# Copy this file to .env and fill in your actual API keys
# NEVER commit this file to version control (add to .gitignore)

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/rakshabandhan

# ============================================
# Google Gemini LLM
# ============================================
# Get API key from: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_gemini_api_key_here

# ============================================
# Pinecone Vector Database
# ============================================
# Get API key from: https://app.pinecone.io/
# Index name for RAG context retrieval
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=rag-schemes-index

# ============================================
# Database Cleanup Scheduler
# ============================================
# Enable automatic database cleanup (True/False)
ENABLE_DB_CLEANUP=True
# Interval in hours to clear all chat data (default: 24)
DB_CLEANUP_INTERVAL_HOURS=24

# ============================================
# Server Configuration
# ============================================
DEBUG=True
HOST=127.0.0.1
PORT=8000

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# ============================================
# Application Settings
# ============================================
APP_NAME=Rakshabandhan
APP_VERSION=1.0.0

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
